FROM docker:29.0.0-dind@sha256:96789d56621ae702a2f8aa316c87a1a1875dd3f02bf67cdcb56a524a09fa3af9 AS cli
FROM node:24.22.2-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9
RUN apt-get update && apt-get install -y --no-install-recommends systemd systemd-sysv dbus dbus-user-session libpam-systemd iptables iproute2 ca-certificates python3 expect curl && rm -rf /var/lib/apt/lists/*
COPY --from=cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker:29-cli@sha256:2357639ad1ea7d0194134bf3292622fd4e562483966ed674e5d7c945b5f3b28d /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
COPY --from=cli /usr/local/bin/dockerd /usr/local/bin/containerd /usr/local/bin/containerd-shim-runc-v2 /usr/local/bin/runc /usr/local/bin/docker-init /usr/local/bin/docker-proxy /usr/local/bin/ctr /usr/local/bin/
RUN mkdir -p /etc/docker && printf '{"features":{"containerd-snapshotter":true}}\n' > /etc/docker/daemon.json && printf '[boot]\nsystemd=true\n[user]\ndefault=root\n' > /etc/wsl.conf && printf '[Unit]\nDescription=Abnahme Docker\nAfter=network.target\n[Service]\nExecStart=/usr/local/bin/dockerd\nRestart=on-failure\n[Install]\nWantedBy=multi-user.target\n' > /etc/systemd/system/docker.service && systemctl enable docker.service
CMD ["/sbin/init"]
