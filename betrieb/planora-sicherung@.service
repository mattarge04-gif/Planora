[Unit]
Description=Planora naechtlicher Sicherungssatz (%i)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/planora/%i/instanz.env
# Sicherung, danach Retention nur bei Erfolg; jeder Fehler loest den Betriebsalarm aus (alarm.json).
ExecStart=/usr/bin/env node ${PLANORA_BUNDLE_DIR}/werkzeug/betrieb/host-cli.js sichern --instanz %i --anlass nacht
